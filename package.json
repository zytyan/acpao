{
  "name": "acpao",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/server/src/main.js",
    "gateway": "tsx apps/gateway/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "playwright test",
    "gateway:start": "node dist/apps/gateway/src/main.js",
    "format": "prettier --write apps packages scripts tests docs README.md *.json *.ts",
    "probe:agent": "node --import tsx scripts/probe-agent.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "build:gateway-assets": "node scripts/sea/gateway-assets.mjs",
    "build:binary": "npm run build && npm run build:gateway-assets && node scripts/sea/build.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-virtual": "3.14.26",
    "fastify": "5.12.8",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "selfsigned": "5.5.0",
    "ssh2": "1.17.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
